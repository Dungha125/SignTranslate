# Sao chép thành deploy/.env trên server rồi đổi mật khẩu.
SIGN_TRANSLATE_DEFAULT_MODEL=lt_signdiff_v2_top200
CURRIVSL_TOP_K=10

# "user1:pass1,user2:pass2" — bắt buộc đổi, mặc định trong code là admin/admin123.
SIGN_TRANSLATE_USERS=admin:CHANGE_ME

# Danh sách origin được phép gọi API, phân tách bằng dấu phẩy. "*" để mở hết.
SIGN_TRANSLATE_CORS_ORIGINS=https://trans.mophongthuattoan.com

SIGN_TRANSLATE_MAX_UPLOAD_MB=80
SIGN_TRANSLATE_CACHE_TTL=43200
SIGN_TRANSLATE_TOKEN_TTL=43200

# VPS 2 vCPU: giới hạn thread torch/OpenMP để tránh tranh CPU với các service khác.
OMP_NUM_THREADS=2
MKL_NUM_THREADS=2
TORCH_NUM_THREADS=2
